#!/bin/bash

# script/secret-scan: Scan for secrets with betterleaks
#
# Scans the staged changes (the pre-commit hook), a commit range (CI on a pull request) or the whole history, with
# the rules in .betterleaks.toml. Findings are printed redacted and fail the run. Without betterleaks the staged scan
# warns and passes, like the other commit hooks, so a clone without the toolchain can still commit; every other mode
# fails, because CI must not pass a scan it never ran.
#
# Usage:
#   ./script/secret-scan --staged
#   ./script/secret-scan --range <base>..<head>
#   ./script/secret-scan --all
#
# Examples:
#   ./script/secret-scan --staged
#   ./script/secret-scan --range origin/main..HEAD

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

run_hook "secret-scan" "pre"

scan=(git --redact --no-banner)
case "${1:-}" in
--staged) scan+=(--pre-commit --staged) ;;
--range)
    [[ -n ${2:-} ]] || die "--range needs <base>..<head>"
    scan+=("--log-opts=$2")
    ;;
--all) ;;
*) die "Usage: script/secret-scan --staged | --range <base>..<head> | --all" ;;
esac

if [[ ${1:-} == "--staged" ]] && ! command -v betterleaks >/dev/null 2>&1; then
    log_warning "Skipping the secret scan (betterleaks not installed — run script/setup/toolchain)"
    exit 0
fi
require_command betterleaks "script/setup/toolchain"

betterleaks "${scan[@]}" .

run_hook "secret-scan" "post"
