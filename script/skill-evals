#!/bin/bash

# script/skill-evals: Run behavioural evals for the agent skills
#
# Sends each prompt in .agents/skills/*/evals/evals.json to an agent CLI running in
# this repository, then grades the answer against that eval's assertions with a
# second model call. This measures whether a skill actually changes agent
# behaviour — something script/skills-check cannot tell you.
#
# Costs real model calls (two per eval), so it is deliberately NOT part of
# script/check. Run it after editing a skill, and after a Home Assistant version
# bump that may have invalidated a skill's advice.
#
# Works with whichever agent CLI is installed and authenticated: Claude Code,
# Codex CLI, or GitHub Copilot CLI. Auto-detects in that order — Copilot CLI is
# picked only when neither of the other two is available, since it is billed
# separately and typically the most expensive of the three per call.
#
# Default models are unversioned on purpose (tier aliases / "let the CLI decide"),
# so this script does not need editing every time a provider ships a new snapshot:
#   - Claude Code's "sonnet" alias always resolves to the current Sonnet release.
#   - Codex CLI uses whatever model is configured as its own default.
#   - Copilot CLI's "auto" lets Copilot pick a current model itself.
# Set the *_MODEL variables below to pin an exact version instead.
#
# Usage:
#   ./script/skill-evals [skill-name]
#
# Environment:
#   SKILL_EVAL_AGENT      Force a specific agent CLI: claude, codex, or copilot
#                         (default: auto-detect, preferring claude, then codex, then copilot)
#   CLAUDE_MODEL          Model for Claude Code CLI (default: sonnet — always latest Sonnet)
#   CODEX_MODEL           Model for Codex CLI (default: the CLI's configured default)
#   COPILOT_MODEL         Model for GitHub Copilot CLI (default: auto — Copilot picks)
#   SKILL_EVAL_TIMEOUT    Per-call timeout in seconds (default: 300)
#
# Examples:
#   ./script/skill-evals                     # all skills
#   ./script/skill-evals ha-entity-platform  # one skill
#   SKILL_EVAL_AGENT=codex ./script/skill-evals ha-release

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

# shellcheck source=script/.lib/output.sh
source "$SCRIPT_DIR/.lib/output.sh"

activate_venv

SKILL_FILTER="${1:-}"
EVAL_TIMEOUT="${SKILL_EVAL_TIMEOUT:-300}"

if [[ -n $SKILL_FILTER && ! -d ".agents/skills/$SKILL_FILTER" ]]; then
    die "Unknown skill: $SKILL_FILTER (see .agents/skills/)"
fi

# Resolve one agent's binary. Sets AGENT_BIN and returns 0 if found, 1 otherwise.
# copilot keeps its workspace-local node_modules/.bin lookup; claude and codex are
# expected to be globally installed CLIs.
resolve_agent_bin() {
    case "$1" in
    claude)
        command -v claude >/dev/null 2>&1 && AGENT_BIN="$(command -v claude)"
        ;;
    codex)
        command -v codex >/dev/null 2>&1 && AGENT_BIN="$(command -v codex)"
        ;;
    copilot)
        if [[ -x "$PWD/node_modules/.bin/copilot" ]]; then
            AGENT_BIN="$PWD/node_modules/.bin/copilot"
        elif command -v copilot >/dev/null 2>&1; then
            AGENT_BIN="copilot"
        fi
        ;;
    *)
        die "Unknown agent: $1 (expected claude, codex, or copilot)"
        ;;
    esac
    [[ -n ${AGENT_BIN:-} ]]
}

AGENT_NAME="${SKILL_EVAL_AGENT:-}"
AGENT_BIN=""

if [[ -n $AGENT_NAME ]]; then
    resolve_agent_bin "$AGENT_NAME" ||
        die "SKILL_EVAL_AGENT=$AGENT_NAME requested, but the '$AGENT_NAME' CLI was not found on PATH"
else
    for candidate in claude codex copilot; do
        if resolve_agent_bin "$candidate"; then
            AGENT_NAME="$candidate"
            break
        fi
    done
    if [[ -z $AGENT_NAME ]]; then
        die "No agent CLI found. Install one of: Claude Code (npm install -g @anthropic-ai/claude-code), Codex CLI (npm install -g @openai/codex), or GitHub Copilot CLI (npm install @github/copilot)"
    fi
fi

case "$AGENT_NAME" in
claude) MODEL="${CLAUDE_MODEL:-sonnet}" ;;
codex) MODEL="${CODEX_MODEL:-}" ;;
copilot) MODEL="${COPILOT_MODEL:-auto}" ;;
esac

run_hook "skill-evals" "pre"

log_header "Running agent skill evals"
log_info "Agent: $AGENT_NAME ($AGENT_BIN)"
log_info "Model: ${MODEL:-<agent default>}"
if [[ -n $SKILL_FILTER ]]; then
    log_info "Skill: $SKILL_FILTER"
fi
log_warning "This makes real model calls and can take several minutes"

status=0
python3 "$SCRIPT_DIR/.lib/skill_evals.py" \
    --agent "$AGENT_NAME" \
    --agent-bin "$AGENT_BIN" \
    --model "$MODEL" \
    --timeout "$EVAL_TIMEOUT" \
    ${SKILL_FILTER:+--skill "$SKILL_FILTER"} || status=$?

run_hook "skill-evals" "post"

if [[ $status -ne 0 ]]; then
    log_error "Some evals failed — read the report before changing a skill"
    exit "$status"
fi

log_success "All skill evals passed"
