{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|shell|exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/pre-push-check.sh\"",
            "timeout": 10,
            "statusMessage": "Checking that git's pre-push hook will vet this push…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agents/hooks/remind-dependency-sync.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
